# ---------------------------------------------------------------------------
# Copy to .env and fill in. Anything left blank simply disables that feature —
# the provider is not registered — except the three REQUIRED secrets, which
# must be provided or Medusa refuses to start.
# ---------------------------------------------------------------------------

# --- CORS: real origins, not "*" ---
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000

REDIS_URL=redis://localhost:6379

# --- REQUIRED. Generate with: openssl rand -base64 32 ---
# There is deliberately no fallback value in medusa-config.ts; an empty JWT or
# cookie secret used to silently fall back to the string "supersecret".
JWT_SECRET=
COOKIE_SECRET=

DATABASE_URL=
DB_NAME=medusa-backend

# --- Oracle (AI guide) — DeepSeek is the house LLM standard ---
DEEPSEEK_API_KEY=
# DeepSeek publishes deepseek-chat and deepseek-reasoner. The previous default
# here ("deepseek-v4-pro") was not a real model id.
ORACLE_MODEL=deepseek-chat
# Directory of canon markdown files (default: <backend>/canon)
ORACLE_CANON_DIR=

# --- CJ dropship fulfillment (Phase 4) ---
# Leaving CJ_API_KEY blank means the CJ provider is not registered at all.
CJ_API_KEY=
CJ_EMAIL=
# Keep "true" until a real order is verified end-to-end.
CJ_DRY_RUN=true

# CJ product discovery (daily job -> drafts for human review, never auto-publishes)
# CJ_DISCOVERY_KEYWORDS=amethyst,crystal bracelet,orgonite
# CJ_DISCOVERY_MAX_PRICE=25
# CJ_DISCOVERY_MIN_LISTED=50
# CJ_DISCOVERY_LIMIT=5
# CJ_DISCOVERY_DRY_RUN=true

# --- Stripe payments (test mode until live keys are provided) ---
# Blank STRIPE_API_KEY means the Stripe provider is not registered.
STRIPE_API_KEY=
# REQUIRED for async payment methods (3DS, redirects). Without it those orders
# stay "pending" after a successful charge.
STRIPE_WEBHOOK_SECRET=

# --- Resend transactional email ---
# Leaving RESEND_API_KEY blank means no email is sent (provider not registered).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Voyage AI embeddings for product semantic search (voyage-4-large, 1024d).
# The postgres search provider embeds the product `semantic` field at index
# time and embeds vector queries at search time.
#
# IMPORTANT: without this key the search index cannot be built, and because
# /store is search-only the entire product listing renders empty — the
# homepage still works, so the site looks alive until you click "see the
# whole collection". Set this key, or accept an empty /store.
VOYAGE_API_KEY=

# Set to "true" ONLY when the backend is behind your own reverse proxy, so the
# x-forwarded-for header can be trusted for rate limiting. Left unset, the
# limiter uses the socket address instead of the spoofable header.
TRUST_PROXY=
