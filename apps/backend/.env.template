# CJ dropship fulfillment (Phase 4)
CJ_API_KEY=
CJ_EMAIL=
# Keep "true" until a real order is verified end-to-end
CJ_DRY_RUN=true

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Voyage AI embeddings for product semantic search (voyage-4-large, 1024d).
# The postgres search provider embeds the product `semantic` field at index
# time and embeds vector queries at search time. Without this key, product
# indexing fails with a clear error; backend startup is unaffected.
VOYAGE_API_KEY=
