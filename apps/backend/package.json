{
  "name": "@dtc/backend",
  "version": "0.0.1",
  "description": "3rd Eye Supply Medusa backend",
  "author": "3rd Eye Supply",
  "license": "MIT",
  "keywords": [
    "medusa",
    "ecommerce",
    "postgres"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "seed": "medusa exec ./src/migration-scripts/initial-data-seed.ts",
    "seed:demo": "medusa exec ./src/scripts/seed-demo-products.ts",
    "audit:intents": "medusa exec ./src/scripts/audit-intents.ts",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@devx-commerce/passwordless": "^12.0.0-beta.0",
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/admin-shared": "2.21.2",
    "@medusajs/analytics-posthog": "^2.21.2",
    "@medusajs/caching": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/dashboard": "2.21.2",
    "@medusajs/draft-order": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/payment-stripe": "2.21.2",
    "@medusajs/ui": "4.2.6",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.57.0",
    "@opentelemetry/instrumentation-pg": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@rokmohar/medusa-plugin-meilisearch": "^2.3.1",
    "@sentry/node": "^8.0.0",
    "@sentry/opentelemetry": "^8.0.0",
    "@tanstack/react-query": "5.64.2",
    "nodemailer": "^10.1.1",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "twilio": "^6.2.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.2",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
