      "parameters": {
        "jsCode": "// Reaching here means every HTTP step returned 2xx.\nconst cart = $('Set shipping method').first().json.cart || {};\nconst methods = cart.shipping_methods || [];\nconst items = cart.items || [];\nconst fails = [];\nif (!items.length) fails.push('cart has no line items');\nif (!methods.length) fails.push('no shipping method attached');\nif (methods.length && methods[0].shipping_option_id !== 'so_01M4MY97ZSMAD5755XZ45DB1GN') fails.push('shipping option is ' + methods[0].shipping_option_id + ', expected the CJ option');\nif (!(Number(cart.total) > 0)) fails.push('cart total is ' + cart.total);\nconst summary = { checkedAt: new Date().toISOString(), items: items.length, shippingMethod: methods[0] && methods[0].name, total: cart.total, currency: cart.currency_code };\nif (fails.length) { return [{ json: Object.assign({ ok: false, fails }, summary) }]; }\nreturn [{ json: Object.assign({ ok: true }, summary) }];"
